{
  "name": "qa-asd-ste100",
  "version": "0.2.0",
  "private": true,
  "description": "Build automated tests by using your application and talking to an assistant; translate them into your team's framework.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "setup:electron": "node node_modules/electron/install.js",
    "dist": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always",
    "icons": "node scripts/make-icons.mjs",
    "dist:offline": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "@anthropic-ai/sdk": "^0.135.0",
    "dotenv": "^18.0.8",
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "productName": "QA-ASD-STE100",
  "author": "Beniamin Zotescu"
}
